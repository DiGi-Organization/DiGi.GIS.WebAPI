<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<OutputPath>..\bin\</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<None Include="Classes\Parameter\CountByAdministrativeAreal2DIdsParameter.cs" />
		<!-- DiGi.Geometry is referenced by HintPath, so its NuGet dependencies do not reach this host.
		     The county part decision and the BDOT10k import both run planar geometry here, and a missing
		     QuikGraph surfaces only at runtime, per building, long after everything built and tested clean. -->
		<PackageReference Include="QuikGraph" Version="2.5.0" />
		<PackageReference Include="NetTopologySuite" Version="2.6.0" />
		<PackageReference Include="Npgsql" Version="10.0.2" />
		<PackageReference Include="ProjNET4GeoAPI" Version="1.4.1" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<!-- Validates the user extension's bearer tokens in-action. Declared at the EXACT version DiGi.User.WebAPI
		     references (10.0.5): both extensions are one probing set, so a Microsoft.IdentityModel version drift between
		     the two is invisible until a MissingMethodException at the first token. Not in the ASP.NET shared framework. -->
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.5" />
		<!-- TableWireFormatSchemaFilter implements the host's IWebAPISchemaFilter hook, whose signature
		     needs Swashbuckle's SchemaFilterContext and Microsoft.OpenApi's IOpenApiSchema at compile time.
		     DiGi.WebAPI is referenced by HintPath, which does not carry its NuGet dependencies here, so both
		     are declared at the exact versions DiGi.WebAPI and the host pin (DiGi.GIS.WebAPI#44). -->
		<PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.2.0" />
		<PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
	</ItemGroup>

	<Target Name="CopyFiles" AfterTargets="Build">
		<ItemGroup>
			<_Files Include="$(ProjectDir)..\files\**\*.*" />
		</ItemGroup>
		<Message Text="Copying all files from directory..." Importance="high" />
		<Copy SourceFiles="@(_Files)" DestinationFiles="@(_Files->'$(OutputPath)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
	</Target>

	<Target Name="CopyUserFiles" AfterTargets="CopyFiles">
		<ItemGroup>
			<_UserFiles Include="$(ProjectDir)..\user files\**\*.*" />
		</ItemGroup>
		<Message Text="Copying all user files from directory..." Importance="high" />
		<Copy SourceFiles="@(_UserFiles)" DestinationFiles="@(_UserFiles->'$(OutputPath)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
	</Target>

	<ItemGroup>
		<Reference Include="DiGi.Analytical">
		  <HintPath>..\..\DiGi.Analytical\bin\DiGi.Analytical.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.Analytical.Building">
		  <HintPath>..\..\DiGi.Analytical\bin\DiGi.Analytical.Building.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.Analytical.Building.HVAC">
		  <HintPath>..\..\DiGi.Analytical\bin\DiGi.Analytical.Building.HVAC.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.BDL">
		  <HintPath>..\..\DiGi.BDL\bin\DiGi.BDL.dll</HintPath>
		</Reference>
		<!-- Not used directly. Overload resolution on Convert.ToDiGi in Building2DController drags in
		     candidates whose signatures mention BDOT10k types (OT_ADJA_A, OT_BUBD_A, ...), and the
		     compiler needs the metadata to reject them (CS0012). -->
		<Reference Include="DiGi.BDOT10k">
		  <HintPath>..\..\DiGi.BDOT10k\bin\DiGi.BDOT10k.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.CityGML">
		  <HintPath>..\..\DiGi.CityGML\bin\DiGi.CityGML.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.Core">
			<HintPath>..\..\DiGi.Core\bin\DiGi.Core.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.Core.IO">
		  <HintPath>..\..\DiGi.Core\bin\DiGi.Core.IO.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.Core.Parameter">
		  <HintPath>..\..\DiGi.Core\bin\DiGi.Core.Parameter.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.Core.Relation">
			<HintPath>..\..\DiGi.Core\bin\DiGi.Core.Relation.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.EPW">
			<HintPath>..\..\DiGi.EPW\bin\DiGi.EPW.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.Geometry">
			<HintPath>..\..\DiGi.Geometry\bin\DiGi.Geometry.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.Geometry.Object">
		  <HintPath>..\..\DiGi.Geometry\bin\DiGi.Geometry.Object.dll</HintPath>
		</Reference>
		<!-- Declared for deployment, not for compilation. DiGi.GIS.PostgreSQL took a dependency on this
		     assembly for the terrain point store, and a HintPath reference does not carry its own
		     references into a consumer's output - so without this entry the extension deploys into
		     DiGi.WebAPI.WindowsService\bin\extensions\gis without it, and the host, which shares one
		     probing set with its extensions, has no other copy to find. -->
		<Reference Include="DiGi.Geometry.PointCloud">
		  <HintPath>..\..\DiGi.Geometry.PointCloud\bin\DiGi.Geometry.PointCloud.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.GIS">
			<HintPath>..\..\DiGi.GIS\bin\DiGi.GIS.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.GIS.Analytical">
		  <HintPath>..\..\DiGi.GIS.Analytical\bin\DiGi.GIS.Analytical.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.GIS.IO">
		  <HintPath>..\..\DiGi.GIS.IO\bin\DiGi.GIS.IO.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.GIS.PostgreSQL">
		  <HintPath>..\..\DiGi.GIS.PostgreSQL\bin\DiGi.GIS.PostgreSQL.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.GML">
		  <HintPath>..\..\DiGi.GML\bin\DiGi.GML.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.PostgreSQL">
		  <HintPath>..\..\DiGi.PostgreSQL\bin\DiGi.PostgreSQL.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.PostgreSQL.Table">
		  <HintPath>..\..\DiGi.PostgreSQL\bin\DiGi.PostgreSQL.Table.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.PRG">
		  <HintPath>..\..\DiGi.PRG\bin\DiGi.PRG.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.PRG.Geometry">
		  <HintPath>..\..\DiGi.PRG\bin\DiGi.PRG.Geometry.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.Serilog">
		  <HintPath>..\..\DiGi.Serilog\bin\DiGi.Serilog.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.Weather">
		  <HintPath>..\..\DiGi.Weather\bin\DiGi.Weather.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.WebAPI">
			<HintPath>..\..\DiGi.WebAPI\bin\DiGi.WebAPI.dll</HintPath>
		</Reference>
	</ItemGroup>



</Project>

